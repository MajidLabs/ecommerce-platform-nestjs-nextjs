# Backend API — used for server-side fetches (Server Components, Route Handlers)
BACKEND_URL=http://localhost:4000/api/v1

# Same backend, but reachable from the browser — used only if you ever need a
# direct client call outside the /api/proxy route (rare; prefer the proxy).
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000/api/v1

# Must match backend's JWT_ACCESS_SECRET exactly — middleware verifies the
# access token signature at the edge before allowing protected routes.
JWT_ACCESS_SECRET=change-this-access-secret

# Stripe publishable key (test mode) — safe to expose to the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
